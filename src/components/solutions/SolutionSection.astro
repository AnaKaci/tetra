---
interface Props { id: string; label: string; title: string; intro?: string; layout?: 'split' | 'full'; }
const { id, label, title, intro, layout = 'split' } = Astro.props;
---
<section id={id} class:list={['solution-section', `solution-section--${layout}`]} aria-labelledby={`${id}-title`}>
  <header class="solution-section-heading">
    <p class="solution-label">{label}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    {intro && <p class="solution-section-intro">{intro}</p>}
  </header>
  <div class="solution-section-body"><slot /></div>
</section>
