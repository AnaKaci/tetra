---
import Breadcrumbs from '../Breadcrumbs.astro';
import Photo from '../Photo.astro';
import Button from '../Button.astro';
import type { SolutionDetail } from '../../data/solution-details';
interface Props { detail: SolutionDetail; }
const { detail } = Astro.props;
---
<section class="solution-hero" aria-labelledby="page-title">
  <div class="solution-container">
    <Breadcrumbs items={[{ label: 'Zgjidhje', href: '/zgjidhje/' }, { label: detail.title }]} />
    <div class="solution-hero-grid">
      <div class="solution-hero-copy">
        <p class="solution-label">{detail.label}</p>
        <h1 id="page-title">{detail.title}</h1>
        <p class="solution-intro">{detail.intro}</p>
        <Button href="/kontakt/" class="solution-button">Kërko ofertë</Button>
      </div>
      {detail.hero.image && <figure class:list={['solution-hero-media', { 'solution-hero-media--contain': detail.hero.imageFit === 'contain' }]}>
        <Photo image={detail.hero.image} priority sizes="(max-width: 800px) 100vw, 50vw" />
        {detail.hero.caption && <figcaption>{detail.hero.caption}</figcaption>}
      </figure>}
      {detail.hero.ranges && <div class="solution-ranges" aria-label="Gama e fuqive të karikimit">
        {detail.hero.ranges.map(range => <div class="solution-range">
          <span class="solution-range-type">{range.label}</span>
          <div><p class="solution-range-power">{range.power}</p><p class="solution-range-models">{range.models}</p></div>
        </div>)}
        <p class="solution-range-note">Fuqi sipas modelit dhe konfigurimit</p>
      </div>}
    </div>
    <dl class="solution-facts">{detail.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
  </div>
</section>
