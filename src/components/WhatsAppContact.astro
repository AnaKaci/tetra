
---
import Icon from './Icon.astro';

const phoneNumber = '355676095841';
const message = 'Përshëndetje! Jam i interesuar për zgjidhjet e Tetra dhe dëshiroj të kërkoj një ofertë.';
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
const whatsappPath = 'M20.52 3.48A11.91 11.91 0 0 0 12.04 0C5.45 0 .08 5.37.08 11.96c0 2.11.55 4.17 1.6 5.99L0 24l6.19-1.62a11.94 11.94 0 0 0 5.85 1.49h.01c6.59 0 11.95-5.37 11.95-11.96 0-3.19-1.24-6.19-3.48-8.43ZM12.04 21.85a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.67.96.98-3.58-.23-.37a9.88 9.88 0 0 1-1.51-5.31c0-5.48 4.46-9.94 9.95-9.94a9.9 9.9 0 0 1 7.03 2.91 9.88 9.88 0 0 1 2.91 7.03c0 5.48-4.46 9.94-9.95 9.94Zm5.46-7.44c-.3-.15-1.77-.87-2.04-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.11 3.22 5.11 4.52.72.31 1.28.5 1.71.64.72.23 1.37.2 1.88.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z';
---

<div class="whatsapp-contact" data-whatsapp-contact>
  <button
    class="whatsapp-launcher"
    type="button"
    aria-label="Na kontaktoni në WhatsApp"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="whatsapp-options"
    data-whatsapp-toggle
    hidden
  >
    <svg
      width="34"
      height="34"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d={whatsappPath} />
    </svg>
  </button>

  <section
    id="whatsapp-options"
    class="whatsapp-card"
    role="dialog"
    aria-labelledby="whatsapp-title"
    aria-describedby="whatsapp-description"
    hidden
  >
    <button
      class="whatsapp-close"
      type="button"
      aria-label="Mbyll WhatsApp"
      data-whatsapp-close
    >
      <Icon name="close" size={20} />
    </button>

    <p class="whatsapp-label">TETRA · WhatsApp</p>
    <h2 id="whatsapp-title">Keni nevojë për ndihmë?</h2>
    <p id="whatsapp-description">
      Na shkruani për më shumë informacion mbi zgjidhjet tona.
    </p>

    <a
      class="whatsapp-quote"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-whatsapp-quote
    >
      <span>Kërko ofertë</span>
      <Icon name="diagonal" size={18} />
    </a>
  </section>

  <noscript>
    <a
      class="whatsapp-launcher"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Na kontaktoni në WhatsApp"
    >
      <svg
        width="34"
        height="34"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d={whatsappPath} />
      </svg>
    </a>
  </noscript>
</div>

<script>
  const contact = document.querySelector<HTMLElement>(
    '[data-whatsapp-contact]'
  );

  const toggle = contact?.querySelector<HTMLButtonElement>(
    '[data-whatsapp-toggle]'
  );

  const panel = contact?.querySelector<HTMLElement>(
    '#whatsapp-options'
  );

  const close = contact?.querySelector<HTMLButtonElement>(
    '[data-whatsapp-close]'
  );

  const quote = contact?.querySelector<HTMLAnchorElement>(
    '[data-whatsapp-quote]'
  );

  if (contact && toggle && panel && close && quote) {
    const setOpen = (open: boolean): void => {
      panel.hidden = !open;

      toggle.setAttribute(
        'aria-expanded',
        String(open)
      );

      (open ? quote : toggle).focus({
        preventScroll: true
      });
    };

    toggle.hidden = false;

    // FIX: Always pass a boolean to setOpen()
    toggle.addEventListener('click', () => {
      setOpen(Boolean(panel.hidden));
    });

    close.addEventListener('click', () => {
      setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        event.preventDefault();
        setOpen(false);
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (
        !panel.hidden &&
        event.target instanceof Node &&
        !contact.contains(event.target)
      ) {
        setOpen(false);
      }
    });
  }
</script>

<style>
  .whatsapp-contact {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 40;
  }

  .whatsapp-launcher {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--white);
    color: var(--blue);
    box-shadow: 0 6px 24px rgb(7 27 58 / 18%);
    transition: transform .2s, box-shadow .2s, background .2s;
  }

  .whatsapp-launcher:hover {
    background: var(--pale);
    transform: translateY(-3px);
    box-shadow: 0 9px 28px rgb(7 27 58 / 23%);
  }

  .whatsapp-card {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    width: min(
      320px,
      calc(100vw - 40px - env(safe-area-inset-left) - env(safe-area-inset-right))
    );
    max-height: calc(100dvh - 114px - env(safe-area-inset-bottom));
    overflow-y: auto;
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 12px 40px rgb(7 27 58 / 16%);
    animation: whatsapp-appear .2s ease-out;
  }

  .whatsapp-close {
    position: absolute;
    top: 5px;
    right: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
  }

  .whatsapp-close:hover {
    background: var(--pale);
    color: var(--navy);
  }

  .whatsapp-label {
    margin-right: 20px;
    color: var(--blue-hover);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 1px;
  }

  .whatsapp-card h2 {
    margin-top: 15px;
    color: var(--navy);
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -.6px;
  }

  #whatsapp-description {
    margin-top: 10px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .whatsapp-quote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    margin-top: 21px;
    padding: 12px 16px;
    border-radius: 9px;
    background: var(--blue-hover);
    color: var(--white);
    font-size: 13px;
    font-weight: 700;
    transition: background .2s;
  }

  .whatsapp-quote:hover {
    background: var(--navy);
  }

  [hidden] {
    display: none;
  }

  @keyframes whatsapp-appear {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-launcher,
    .whatsapp-quote {
      transition: none;
    }

    .whatsapp-launcher:hover {
      transform: none;
    }

    .whatsapp-card {
      animation: none;
    }
  }
</style>
