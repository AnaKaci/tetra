---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import data from '../data/tetra.json';
import background from '../../public/images/tetra-skidata.png';

const capabilities = [
  { lines: ['PARKIM', 'INTELIGJENT'], icon: 'car' },
  { lines: ['KARIKIM', 'EV'], icon: 'charging' },
  { lines: ['AKSES I', 'SIGURT'], icon: 'lock' },
  { lines: ['MENAXHIM', 'I INTEGRUAR'], icon: 'building' },
];
---
<section id="kreu" class="hero" aria-labelledby="hero-title">
  <div class="hero-scene" aria-hidden="true">
    <Image src={background} alt="" class="hero-photo" widths={[480, 800, 1200, background.width]} sizes="(max-width: 700px) 1600px, (max-width: 1100px) 1300px, 100vw" format="webp" quality={85} loading="eager" fetchpriority="high" decoding="async" />
  </div>
  <div class="container hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">TEKNOLOGJI PËR NJË TË NESËRME MË TË MIRË</p>
      <h1 id="hero-title"><span>SMART<span class="headline-dot"> · </span></span><span>SECURE<span class="headline-dot"> · </span></span><span class="hero-blue">GREEN</span></h1>
      <p class="hero-description">{data.hero.intro}</p>
      <div class="hero-buttons">
        <Button href="/zgjidhje/">Zgjidhje</Button>
        <Button href="/kontakt/" variant="secondary">Na kontaktoni</Button>
      </div>
      <ul class="capabilities" aria-label="Zgjidhjet Tetra">
        {capabilities.map(capability => <li class="capability"><Icon name={capability.icon} size={29} /><span>{capability.lines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; color: var(--white); background: var(--navy); }
  .hero-scene { position: absolute; inset: 0; z-index: -2; }
  .hero-scene :global(.hero-photo) { width: 100%; height: 100%; object-fit: cover; object-position: 64% 57%; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(2 23 47 / 94%) 0%, rgb(3 28 56 / 85%) 23%, rgb(3 30 61 / 75%) 50%, rgb(5 29 54 / 16%) 73%, rgb(5 24 45 / 5%) 100%), linear-gradient(0deg, rgb(2 23 46 / 64%), transparent 46%); }
  .hero-layout { min-height: clamp(650px, 48.5vw, 740px); display: flex; align-items: center; padding-block: 80px; }
  .hero-copy { width: 100%; padding-bottom: 4px; }
  .hero .eyebrow { display: block; color: #b1deff; font-size: 11px; letter-spacing: 3px; line-height: 1.7; font-weight: 750; margin-bottom: 18px; }
  h1 { display: flex; flex-wrap: wrap; align-items: baseline; font-size: clamp(48px, 4.35vw, 68px); line-height: 1.13; letter-spacing: -1.8px; font-weight: 800; }
  h1 > span { white-space: nowrap; }
  .headline-dot { display: inline-block; padding-inline: .18em; color: white; }
  .hero-blue { color: #0788ff; }
  .hero-description { max-width: 615px; margin-top: 20px; color: #f1f6fc; font-size: 18px; line-height: 1.65; font-weight: 450; }
  .hero-buttons { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 28px; }
  .hero-buttons :global(.button) { min-width: 158px; min-height: 49px; border-radius: 999px; padding: 12px 26px; gap: 16px; font-size: 13px; transition: background .2s, border-color .2s, transform .2s; }
  .hero-buttons :global(.button:hover) { transform: translateY(-2px); }
  .hero-buttons :global(.button--secondary) { color: white; background: rgb(3 25 50 / 35%); border: 1.5px solid #078dff; }
  .hero-buttons :global(.button--secondary:hover) { background: rgb(0 107 255 / 24%); border-color: #9ed6ff; }
  .hero :global(a:focus-visible) { outline-color: white; }
  .capabilities { display: grid; grid-template-columns: 1fr .86fr .97fr 1.15fr 1.18fr; gap: 0; list-style: none; margin: 43px 0 0; padding: 0; width: min(650px, 100%); }
  .capability { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding-inline: 25px; }
  .capability:first-child { padding-left: 0; }
  .capability:last-child { padding-right: 0; }
  .capability + .capability::before { content: ''; position: absolute; left: 0; top: 5px; bottom: 0; width: 1px; background: rgb(21 126 222 / 48%); }
  .capability :global(svg) { color: #f4f9ff; stroke-width: 1.45; }
  .capability > span { font-size: 10px; font-weight: 700; letter-spacing: .9px; line-height: 1.5; }

  @media (min-width: 1640px) {
    .hero-layout { width: min(1600px, calc(100% - 224px)); }
  }
  @media (max-width: 1100px) {
    .hero-layout { min-height: 650px; }
    .hero::before { background: linear-gradient(90deg, rgb(2 23 47 / 93%) 0%, rgb(3 28 56 / 82%) 35%, rgb(3 30 61 / 43%) 65%, rgb(5 24 45 / 14%) 100%), linear-gradient(0deg, rgb(2 23 46 / 65%), transparent 55%); }
    .hero-description { max-width: 560px; font-size: 17px; }
    h1 { font-size: clamp(38px, 4.9vw, 54px); letter-spacing: -1.4px; }
    .hero .eyebrow { font-size: 10px; letter-spacing: 2px; }
    .capabilities { width: min(610px, 100%); }
    .capability { padding-inline: 21px; }
  }
  @media (max-width: 700px) {
    .hero-layout { min-height: 780px; padding-top: 49px; padding-bottom: 34px; align-items: flex-start; }
    .hero-copy { display: flex; flex-direction: column; min-height: 697px; }
    .hero-scene :global(.hero-photo) { object-position: 72% bottom; }
    .hero::before { background: linear-gradient(180deg, rgb(3 24 48 / 97%) 0%, rgb(3 26 53 / 93%) 28%, rgb(3 26 53 / 67%) 46%, rgb(3 26 53 / 17%) 67%, rgb(3 26 53 / 80%) 78%, rgb(3 26 53 / 98%) 100%); }
    .hero .eyebrow { font-size: 9px; letter-spacing: 1.8px; line-height: 1.9; max-width: 340px; margin-bottom: 18px; }
    h1 { max-width: 520px; font-size: clamp(37px, 6.2vw, 43px); line-height: 1.15; letter-spacing: -1.2px; }
    .hero-description { max-width: 480px; font-size: 15px; line-height: 1.75; margin-top: 18px; }
    .hero-buttons { margin-top: 24px; gap: 12px; }
    .hero-buttons :global(.button) { min-width: 145px; min-height: 47px; padding-inline: 19px; font-size: 12px; gap: 14px; }
    .capabilities { margin-top: auto; padding-top: 210px; grid-template-columns: repeat(6, 1fr); gap: 21px 0; width: 100%; }
    .capability { grid-column: span 2; align-items: center; text-align: center; padding-inline: 8px; gap: 8px; }
    .capability:first-child { padding-left: 8px; }
    .capability:last-child { padding-right: 8px; }
    .capability:nth-child(4) { grid-column: 2 / 4; }
    .capability:nth-child(5) { grid-column: 4 / 6; }
    .capability:nth-child(4)::before { display: none; }
    .capability > span { font-size: 9px; letter-spacing: .8px; }
    .capability :global(svg) { width: 25px; height: 25px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-buttons :global(.button:hover) { transform: none; }
  }
</style>
