---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SolutionHero from '../../components/solutions/SolutionHero.astro';
import SolutionContent from '../../components/solutions/SolutionContent.astro';
import SolutionContact from '../../components/solutions/SolutionContact.astro';
import { solutionDetails } from '../../data/solution-details';
import type { Solution } from '../../types/content';
import data from '../../data/tetra.json';
import '../../styles/pages.css';
import '../../styles/solutions.css';

export function getStaticPaths() {
  return data.solutions.map(solution => ({ params: { slug: solution.slug }, props: { solution } }));
}
interface Props { solution: Solution; }
const { solution } = Astro.props;
const detail = solutionDetails[solution.id];
if (!detail) throw new Error(`Missing solution presentation: ${solution.id}`);
const partners = data.partners.filter(partner => solution.relatedPartnerIds.includes(partner.id));
---
<BaseLayout title={detail.title} description={detail.intro} image={detail.hero.image ?? solution.image} canonicalPath={solution.href} pageClass="solution-page">
  <SolutionHero detail={detail} />
  <div class="solution-container solution-content">
    {detail.sections.map(section => <SolutionContent section={section} />)}
  </div>
  <SolutionContact text={detail.contact} partners={partners} />
</BaseLayout>
