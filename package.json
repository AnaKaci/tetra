{
  "name": "tetra-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/check-budget.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "sync:content": "node scripts/sync-tetra-content.mjs",
    "build:fresh": "npm run sync:content && npm run build",
    "check": "astro check",
    "test": "playwright test",
    "test:content": "node --test tests/content-sync.test.mjs",
    "test:mobile": "node tests/mobile/run.mjs",
    "test:solutions": "node tests/solutions/run.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "package:cpanel": "node scripts/package-cpanel.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
